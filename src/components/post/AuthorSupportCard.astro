---
/**
 * Author & Support Card (Futuristic 3D Flip Card)
 * Placed at the end of every blog post before comments.
 * Fully responsive across all mobile screens, tablets, and desktop resolutions.
 */
import { Icon } from 'astro-icon/components';

interface Props {
  className?: string;
  githubUrl?: string;
  qrisImage?: string;
  merchantName?: string;
  nmid?: string;
}

const {
  className = '',
  githubUrl = 'https://github.com/shl-project-acc',
  qrisImage = 'https://img.shlproject.com/2026/09/460b94b9438bde44b1684306c6d37186.webp',
  merchantName = 'SHL PROJECT, DIGITAL & KREATIF',
  nmid = 'ID1026581646084',
} = Astro.props;
---

<div class={`author-support-wrapper my-6 w-full ${className}`}>
  <div class="flip-box" id="author-flip-container">
    <div class="flip-box-inner">
      <!-- FRONT SIDE: AUTHOR IDENTITY & TAGS -->
      <div class="flip-face flip-face-front flex flex-col justify-between p-4 sm:p-5 md:p-6">
        <!-- Extended Corner Brackets -->
        <div class="corner-bracket-tl"></div>
        <div class="corner-bracket-br"></div>

        <!-- Top Row: Ecosystem Header & GitHub Link -->
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-1.5 min-w-0">
            <span class="inline-block h-2 w-2 shrink-0 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="truncate font-mono text-[9px] sm:text-[10px] uppercase tracking-widest text-muted-foreground">
              AUTHOR PROFILE // SHL PROJECT ECOSYSTEM
            </span>
          </div>

          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 flex items-center gap-1.5 rounded border border-border bg-muted/60 px-2 py-0.5 font-mono text-[10px] sm:text-[11px] font-semibold text-foreground transition-colors hover:border-primary/40 hover:bg-muted"
            aria-label="GitHub SHL PROJECT"
            onclick="event.stopPropagation()"
          >
            <Icon name="ri:github-fill" class="h-3.5 w-3.5" />
            <span>GitHub</span>
          </a>
        </div>

        <!-- Center Author Info & Tags -->
        <div class="my-auto flex items-center gap-3 sm:gap-4 py-2">
          <!-- Clean Sleek Avatar Frame -->
          <div class="relative shrink-0">
            <div class="h-14 w-14 sm:h-16 sm:w-16 overflow-hidden rounded-lg border border-border/80 bg-card shadow-sm">
              <img
                src="/img/avatarnews.gif"
                alt="SHL PROJECT"
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <!-- Description & Hashtags -->
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
              <h3 class="font-sans text-sm sm:text-base font-bold tracking-tight text-foreground">
                SHL PROJECT
              </h3>
              <div class="flex flex-wrap items-center gap-1 font-mono text-[9px] sm:text-[10px] text-primary">
                <span class="rounded bg-primary/10 border border-primary/20 px-1.5 py-0.5 font-semibold">#Creator</span>
                <span class="rounded bg-primary/10 border border-primary/20 px-1.5 py-0.5 font-semibold">#Developer</span>
                <span class="rounded bg-primary/10 border border-primary/20 px-1.5 py-0.5 font-semibold">#Researcher</span>
              </div>
            </div>
            <p class="mt-1 text-[11px] sm:text-xs leading-relaxed text-muted-foreground">
              Hanya seorang pembelajar yang haus akan ilmu pengetahuan dan mencintai ketenangan, merajut gagasan lewat riset, tulisan, dan rekayasa kode.
            </p>
          </div>
        </div>

        <!-- Bottom Tagline & Flip Cue -->
        <div class="flex items-center justify-between border-t border-border/60 pt-2.5 sm:pt-3 text-[10px] sm:text-[11px] text-muted-foreground">
          <span class="truncate font-mono text-[9px] sm:text-[10px] tracking-wider text-primary/90 mr-2">
            [ DARI ILMU KE AMAL, DARI TEORI KE PRAKTIK ]
          </span>
          <div class="shrink-0 flex items-center gap-1 font-mono text-[10px] sm:text-[11px] font-semibold text-primary">
            <span>DUKUNG KAMI</span>
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
          </div>
        </div>
      </div>

      <!-- BACK SIDE: SUPPORT & QRIS CARD -->
      <div class="flip-face flip-face-back flex flex-col justify-between p-4 sm:p-5 md:p-6">
        <!-- Extended Corner Brackets -->
        <div class="corner-bracket-tl"></div>
        <div class="corner-bracket-br"></div>

        <!-- Top Row: Support Header -->
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-1.5 min-w-0">
            <Icon name="ri:heart-pulse-fill" class="h-3.5 w-3.5 text-amber-500 dark:text-amber-400 shrink-0" />
            <span class="truncate font-mono text-[9px] sm:text-[10px] font-bold uppercase tracking-widest text-amber-500 dark:text-amber-400">
              RUANG APRESIASI & DUKUNGAN
            </span>
          </div>
          <span class="shrink-0 font-mono text-[9px] sm:text-[10px] text-muted-foreground">QRIS RESMI</span>
        </div>

        <!-- Center Content: QRIS Container & Message -->
        <div class="my-auto flex items-center gap-3 sm:gap-4 py-2">
          <!-- QRIS Container -->
          <div class="shrink-0 rounded-md border border-gray-300 bg-white p-1 shadow-sm dark:border-gray-700">
            <div class="relative flex h-16 w-16 sm:h-20 sm:w-20 flex-col items-center justify-center overflow-hidden rounded bg-white p-0.5 text-gray-900">
              <img
                src={qrisImage}
                alt="QRIS SHL PROJECT"
                class="h-full w-full object-contain cursor-pointer hover:scale-105 transition-transform"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <!-- Support Text & Button -->
          <div class="min-w-0 flex-1 space-y-2">
            <p class="text-[11px] sm:text-xs leading-relaxed text-muted-foreground">
              Dukungan sukarela kamu membantu operasional server, riset independen, dan web tools tanpa paywall.
            </p>

            <div>
              <button
                type="button"
                id="open-qris-modal-btn"
                class="inline-flex cursor-pointer items-center justify-center rounded-md bg-amber-500 px-3 py-1.5 text-[11px] sm:text-xs font-bold text-gray-950 shadow-md transition-all hover:bg-amber-400 active:scale-95"
              >
                <span>Traktir Ayam Geprek | Scan QRIS</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Bottom NMID & Gratitude -->
        <div class="flex items-center justify-between border-t border-border/60 pt-2.5 sm:pt-3 text-[9px] sm:text-[10px] font-mono text-muted-foreground">
          <span>NMID: {nmid}</span>
          <span class="font-sans text-emerald-500 dark:text-emerald-400 font-medium">Jazakumullah Khairan 🌿</span>
        </div>
      </div>
    </div>
  </div>

  <!-- QRIS FULL-SIZE MODAL -->
  <div
    id="qris-dialog-modal"
    class="fixed inset-0 z-50 flex hidden items-center justify-center bg-black/75 p-3 sm:p-4 backdrop-blur-md transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-labelledby="qris-modal-title"
  >
    <div
      id="qris-dialog-box"
      class="relative w-full max-w-sm scale-95 rounded-xl border border-border bg-card p-4 sm:p-6 text-center shadow-2xl transition-transform duration-200 overflow-y-auto max-h-[90vh]"
    >
      <button
        type="button"
        id="close-qris-modal-btn"
        class="absolute right-3 top-3 cursor-pointer rounded-lg p-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        aria-label="Tutup Dialog QRIS"
      >
        <Icon name="ri:close-line" class="h-5 w-5" />
      </button>

      <div class="mb-2 inline-flex items-center gap-1.5 rounded-full border border-amber-500/20 bg-amber-500/10 px-3 py-1 text-[10px] sm:text-[11px] font-semibold text-amber-600 dark:text-amber-400">
        <Icon name="ri:shield-check-line" class="h-3.5 w-3.5" />
        <span>QRIS RESMI SHL PROJECT</span>
      </div>

      <h3 id="qris-modal-title" class="text-sm sm:text-base font-bold text-foreground">
        {merchantName}
      </h3>
      <p class="mt-1 text-[11px] sm:text-xs text-muted-foreground">
        Dapat di-scan melalui GoPay, OVO, DANA, ShopeePay, BCA, Livin, atau seluruh m-Banking.
      </p>

      <div class="my-3 inline-block rounded-xl border border-gray-200 bg-white p-2 sm:p-3 shadow-md dark:border-gray-800 max-w-full">
        <div class="flex h-52 w-52 sm:h-64 sm:w-64 max-w-full flex-col items-center justify-center overflow-hidden rounded-lg bg-white p-1 mx-auto">
          <img
            src={qrisImage}
            alt="QRIS SHL PROJECT Full Size"
            class="h-full w-full object-contain"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="mt-2 font-mono text-[9px] sm:text-[10px] font-bold text-gray-700">
          NMID: {nmid}
        </div>
      </div>

      <div class="border-t border-border pt-2 text-[11px] sm:text-xs text-muted-foreground">
        <span>Semoga menjadi amal jariyah & berkah 🌿</span>
      </div>
    </div>
  </div>
</div>

<style>
  .author-support-wrapper {
    width: 100%;
  }

  .flip-box {
    perspective: 1200px;
    width: 100%;
    min-height: 235px;
    cursor: pointer;
  }

  .flip-box-inner {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 235px;
    transition: transform 0.65s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }

  .flip-box:hover .flip-box-inner,
  .flip-box.is-flipped .flip-box-inner {
    transform: rotateY(-180deg);
  }

  .flip-face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 8px;
    border: 1px solid hsl(var(--border));
    background-color: hsl(var(--card));
    background-size: 20px 20px;
    background-image: 
      linear-gradient(to right, rgba(125, 125, 125, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(125, 125, 125, 0.05) 1px, transparent 1px);
    overflow: hidden;
  }

  .flip-face-front {
    z-index: 2;
    transform: rotateY(0deg);
  }

  .flip-face-back {
    transform: rotateY(-180deg);
    z-index: 1;
  }

  /* Extended Futuristic Corner Brackets (26px) */
  .corner-bracket-tl {
    position: absolute;
    top: 0;
    left: 0;
    width: 24px;
    height: 24px;
    border-top: 2.5px solid hsl(var(--primary));
    border-left: 2.5px solid hsl(var(--primary));
    border-top-left-radius: 6px;
    pointer-events: none;
  }

  .corner-bracket-br {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 24px;
    height: 24px;
    border-bottom: 2.5px solid hsl(var(--primary));
    border-right: 2.5px solid hsl(var(--primary));
    border-bottom-right-radius: 6px;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .corner-bracket-tl,
    .corner-bracket-br {
      width: 16px;
      height: 16px;
    }
  }
</style>

<script>
  function setupAuthorSupportModal() {
    const flipContainer = document.getElementById('author-flip-container');
    const openBtn = document.getElementById('open-qris-modal-btn');
    const closeBtn = document.getElementById('close-qris-modal-btn');
    const modal = document.getElementById('qris-dialog-modal');
    const dialogBox = document.getElementById('qris-dialog-box');

    // Tap/Click to toggle flip on mobile touch devices
    flipContainer?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a') || target.closest('button') || target.closest('#qris-dialog-modal')) {
        return;
      }
      flipContainer.classList.toggle('is-flipped');
    });

    const openModal = (e: Event) => {
      e.stopPropagation();
      if (!modal || !dialogBox) return;
      modal.classList.remove('hidden');
      setTimeout(() => {
        dialogBox.classList.remove('scale-95');
        dialogBox.classList.add('scale-100');
      }, 10);
    };

    const closeModal = (e?: Event) => {
      e?.stopPropagation();
      if (!modal || !dialogBox) return;
      dialogBox.classList.remove('scale-100');
      dialogBox.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 150);
    };

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  // Support ClientRouter navigation in Astro
  document.addEventListener('astro:page-load', setupAuthorSupportModal);
  // Initial page load fallback
  setupAuthorSupportModal();
</script>
